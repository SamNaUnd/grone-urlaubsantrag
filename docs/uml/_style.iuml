!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam defaultFontColor #203D38
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #50786C
skinparam ArrowThickness 1.2
skinparam TitleFontSize 22
skinparam TitleFontColor #17594D
skinparam CaptionFontSize 12
skinparam CaptionFontColor #63746C
skinparam NoteBackgroundColor #FFF8E8
skinparam NoteBorderColor #D4BE83
skinparam NoteFontSize 12
skinparam PackageStyle rectangle
skinparam PackageBackgroundColor #F8FAF8
skinparam PackageBorderColor #B7CDBF
skinparam ClassBackgroundColor #F2F8F3
skinparam ClassHeaderBackgroundColor #DBEDE2
skinparam ClassBorderColor #50786C
skinparam classAttributeIconSize 0
skinparam UsecaseBackgroundColor #F2F8F3
skinparam UsecaseBorderColor #50786C
skinparam ActorBorderColor #17594D
skinparam ActorFontColor #17594D
skinparam ActivityBackgroundColor #E7F2EB
skinparam ActivityBorderColor #50786C
skinparam ActivityDiamondBackgroundColor #FFF3D8
skinparam ActivityDiamondBorderColor #B39850
skinparam PartitionBackgroundColor #F8FAF8
skinparam PartitionBorderColor #B7CDBF
skinparam ParticipantBackgroundColor #E7F2EB
skinparam ParticipantBorderColor #50786C
skinparam DatabaseBackgroundColor #E7F2EB
skinparam DatabaseBorderColor #50786C
skinparam SequenceGroupBackgroundColor #F8FAF8
skinparam SequenceGroupBorderColor #B7CDBF
skinparam StateBackgroundColor #E7F2EB
skinparam StateBorderColor #50786C
skinparam ComponentBackgroundColor #E7F2EB
skinparam ComponentBorderColor #50786C
skinparam NodeBackgroundColor #F8FAF8
skinparam NodeBorderColor #50786C
