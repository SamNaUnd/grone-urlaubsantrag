@startuml
!include _style.iuml
title Fachliches Klassenmodell
caption Grone Urlaubsverwaltung · Domänenklassen und ihre Beziehungen
hide circle
skinparam classAttributeIconSize 0

enum Role {
  TRAINEE
  INSTRUCTOR
  ADMIN
}

enum LeaveStatus {
  OPEN
  APPROVED
  REJECTED
  WITHDRAWN
}

class UserAccount {
  id: Long
  firstName: String
  lastName: String
  email: String
  passwordHash: String
  role: Role
  active: boolean
  credentialsVersion: int
  createdAt: Instant
}

class Trainee {
  id: Long
  userId: Long
  instructorId: Long
  trainingProgram: String
  trainingLocation: String
  federalState: String
}

class LeaveEntitlement {
  id: Long
  traineeId: Long
  year: int
  days: int
}

class LeaveRequest {
  id: Long
  traineeId: Long
  startDate: LocalDate
  endDate: LocalDate
  totalDays: int
  reason: String
  status: LeaveStatus
  createdAt: Instant
}

class Approval {
  id: Long
  leaveRequestId: Long
  approverId: Long
  decision: LeaveStatus
  comment: String
  decisionDate: Instant
}

UserAccount "1" -- "0..1" Trainee : besitzt Ausbildungsprofil
class RegistrationInvitation {
  id: Long
  codeHash: String
  role: Role
  trainingProgram: String
  instructorId: Long
  entitlementYear: int
  entitlementDays: int
  createdById: Long
  createdAt: Instant
  expiresAt: Instant
  redeemedAt: Instant
  revokedAt: Instant
}
UserAccount "1" -- "0..*" RegistrationInvitation : erstellt
UserAccount "0..1" -- "0..*" RegistrationInvitation : zugeordneter Ausbilder

UserAccount "1" -- "0..*" Trainee : betreut als Ausbilder
Trainee "1" -- "0..*" LeaveEntitlement : hat Jahreskontingente
Trainee "1" -- "0..*" LeaveRequest : stellt Anträge
LeaveRequest "1" -- "0..1" Approval : erhält Entscheidung
UserAccount "1" -- "0..*" Approval : entscheidet als Ausbilder
UserAccount ..> Role
RegistrationInvitation ..> Role
LeaveRequest ..> LeaveStatus
Approval ..> LeaveStatus

note bottom of Trainee
  Die betreuende Person muss aktiv sein
  und die Rolle INSTRUCTOR besitzen.
end note

note bottom of Approval
  Nur der zugeordnete Ausbilder entscheidet.
  Entscheidung: APPROVED oder REJECTED.
  Pro Antrag höchstens eine Entscheidung.
end note

note bottom of RegistrationInvitation
  Verwaltung erstellt AB- und AZ-Einladungen.
  Ausbilder erstellen nur AZ-Codes für eigene Trainees.
  Nur der SHA-256-Hash des Codes wird gespeichert.
end note

@enduml
