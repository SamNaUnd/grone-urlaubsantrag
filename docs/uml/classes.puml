@startuml
hide circle
skinparam classAttributeIconSize 0

enum Role {
  TRAINEE
  INSTRUCTOR
  ADMIN
}

enum LeaveStatus {
  OPEN
  APPROVED
  REJECTED
  WITHDRAWN
}

class UserAccount {
  id: Long
  firstName: String
  lastName: String
  email: String
  passwordHash: String
  role: Role
  active: boolean
  credentialsVersion: int
}

class Trainee {
  id: Long
  trainingProgram: String
  trainingLocation: String
  federalState: String
}

class LeaveEntitlement {
  id: Long
  traineeId: Long
  year: int
  days: int
}

class LeaveRequest {
  id: Long
  startDate: LocalDate
  endDate: LocalDate
  totalDays: int
  reason: String
  status: LeaveStatus
  createdAt: Instant
}

class Approval {
  id: Long
  decision: LeaveStatus
  comment: String
  decisionDate: Instant
}

UserAccount "1" -- "0..1" Trainee : trainee profile
class RegistrationInvitation {
  id: Long
  codeHash: String
  role: Role
  instructorId: Long
  entitlementYear: int
  entitlementDays: int
  expiresAt: Instant
  redeemedAt: Instant
  revokedAt: Instant
}
UserAccount "1" -- "0..*" RegistrationInvitation : creates

UserAccount "1" -- "0..*" Trainee : supervises
Trainee "1" -- "0..*" LeaveEntitlement : annual allowance
Trainee "1" -- "0..*" LeaveRequest : submits
LeaveRequest "1" -- "0..1" Approval : receives
UserAccount "1" -- "0..*" Approval : decides

note bottom of Trainee
  The supervising user must
  have the INSTRUCTOR role.
end note

note bottom of Approval
  Only the assigned instructor
  may decide an open request.
end note

@enduml
