@startuml
hide circle
skinparam linetype ortho

entity "users" as users {
  * id : BIGINT <<PK>>
  --
  * first_name : VARCHAR
  * last_name : VARCHAR
  * email : VARCHAR <<UNIQUE>>
  * password_hash : VARCHAR
  * role : VARCHAR
  * active : BOOLEAN
  * credentials_version : INTEGER
  * created_at : TIMESTAMPTZ
}

entity "trainees" as trainees {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK, UNIQUE>>
  * instructor_id : BIGINT <<FK>>
  * training_program : VARCHAR
  * training_location : VARCHAR
  * federal_state : VARCHAR
}

entity "leave_entitlements" as entitlements {
  * id : BIGINT <<PK>>
  --
  * trainee_id : BIGINT <<FK>>
  * leave_year : INTEGER
  * days : INTEGER
}

entity "leave_requests" as requests {
  * id : BIGINT <<PK>>
  --
  * trainee_id : BIGINT <<FK>>
  * start_date : DATE
  * end_date : DATE
  * total_days : INTEGER
  * reason : VARCHAR(2000)
  * status : VARCHAR
  * created_at : TIMESTAMPTZ
}

entity "approvals" as approvals {
  * id : BIGINT <<PK>>
  --
  * leave_request_id : BIGINT <<FK, UNIQUE>>
  * approver_id : BIGINT <<FK>>
  * decision : VARCHAR
  * comment : VARCHAR(2000)
  * decision_date : TIMESTAMPTZ
}

users ||--o| trainees : "has trainee profile"
entity "registration_invitations" as invitations {
  * id : BIGINT <<PK>>
  --
  * code_hash : VARCHAR(64) <<UNIQUE>>
  * role : VARCHAR
  training_program : VARCHAR
  instructor_id : BIGINT <<FK>>
  * entitlement_year : INTEGER
  * entitlement_days : INTEGER
  * created_by_id : BIGINT <<FK>>
  * created_at : TIMESTAMPTZ
  * expires_at : TIMESTAMPTZ
  redeemed_at : TIMESTAMPTZ
  revoked_at : TIMESTAMPTZ
}
users ||--o{ invitations : "creates / instructor assignment"

users ||--o{ trainees : "supervises"
trainees ||--o{ requests : "submits"
trainees ||--o{ entitlements : "annual allowance"
requests ||--o| approvals : "receives"
users ||--o{ approvals : "decides"

note bottom of users
  Roles: TRAINEE, INSTRUCTOR, ADMIN
end note

note bottom of requests
  Status: OPEN, APPROVED,
  REJECTED, WITHDRAWN

  end_date >= start_date
  total_days > 0
end note

note bottom of approvals
  Decision: APPROVED or REJECTED
  A rejection requires a reason.
end note

note bottom of entitlements
  UNIQUE (trainee_id, leave_year)
  0 <= days <= 366
end note
@enduml
