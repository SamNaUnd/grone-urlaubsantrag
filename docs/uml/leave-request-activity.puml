@startuml
!include _style.iuml
title Ablauf eines Urlaubsantrags
caption Ganze Arbeitstage · Berlin · Ein Kalenderjahr pro Antrag
start

partition "Auszubildende" {
  :Urlaubszeitraum eingeben;
  :Optionale Bemerkung hinzufügen;
}

partition "System" {
  :Zeitraum prüfen;
  :Urlaubstage ohne Wochenenden\nund regionale Feiertage berechnen;
  :Verfügbares Urlaubskontingent prüfen;
}

if (Angaben gültig und ausreichend Urlaub?) then (ja)
  partition "Auszubildende" {
    :Antrag absenden;
  }

  partition "System" {
    :Anmeldung, Rolle und CSRF prüfen\nZeitraum und Kontingent serverseitig erneut prüfen;
    if (Serverprüfung erfolgreich?) then (ja)
    else (nein)
      :Fehler anzeigen; Antrag nicht speichern;
      stop
    endif
    :Antrag mit Status OPEN speichern;
    :Beantragte Tage im Kontingent reservieren;
  }

  if (Vor Bearbeitung zurückgezogen?) then (ja)
    partition "System" {
      :Berechtigung und Status prüfen;
      if (Eigener Antrag und Status OPEN?) then (ja)
      else (nein)
        :Zugriffs- oder Statusfehler anzeigen;
        stop
      endif
      :Status auf WITHDRAWN setzen;
      :Reservierung freigeben;
    }
    stop
  else (nein)
    partition "Ausbilder" {
      :Antrag öffnen und prüfen;
    }

    partition "System" {
      :Zuordnung und Status OPEN prüfen;
      if (Zugeordnet und noch offen?) then (ja)
      else (nein)
        :Zugriffs- oder Statusfehler anzeigen;
        stop
      endif
    }

    if (Antrag genehmigen?) then (ja)
      partition "System" {
        :Urlaubskontingent erneut prüfen;
      }

      if (Gebundene Urlaubstage durch Kontingent gedeckt?) then (ja)
        partition "System" {
          :Genehmigung und Status APPROVED\nin einer Transaktion speichern;
          :Reservierte Tage als genehmigte Tage führen;
        }
      else (nein)
        partition "System" {
          :Konflikt anzeigen\nAntrag bleibt OPEN;
        }
        stop
      endif
    else (nein)
      partition "Ausbilder" {
        :Ablehnungsgrund eingeben;
      }

      if (Begründung vorhanden?) then (ja)
        partition "System" {
          :Ablehnung und Status REJECTED\nin einer Transaktion speichern;
          :Reservierung freigeben;
        }
      else (nein)
        :Eingabefehler anzeigen (400)\nAntrag bleibt OPEN;
        stop
      endif
    endif
  endif

  partition "Auszubildende" {
    :Aktualisierten Status einsehen;
  }
else (nein)
  partition "System" {
    :Fehlermeldung anzeigen;
  }
endif

note right
  Die Vorschau ersetzt keine Serverprüfung.
  Änderungen sperren das Ausbildungsprofil.
  Fehler ändern keinen bestehenden Antragsstatus.
  Feiertagsdienst nicht erreichbar: 503.
  Fremder Zugriff: 403; bereits bearbeitet: 409.
end note
stop
@enduml
